# Header set content-Security-Policy: upgrade-insecure-requests

# Use PHP5CGI as default
#AddHandler fcgid-script .php
<IfModule mod_rewrite.c>
   RewriteEngine On
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
   
    # RewriteRule ^index[\/]?$ index.php
    RewriteRule ^about-us[\/]?$ about-us.php
    RewriteRule ^contact-us[\/]?$ contact-us.php
    RewriteRule ^ana-holidays[\/]?$ ana-holidays.php
    RewriteRule ^our-rooms[\/]?$ our-rooms.php
    RewriteRule ^terms-conditions[\/]?$ terms-conditions.php
    RewriteRule ^gallery[\/]?$ gallery.php
    RewriteRule ^our-policies[\/]?$ our-policies.php

#   RewriteRule ^(.*)$ $1.php [L]
   ## Force www;
   ##RewriteCond %{HTTP_HOST} ^hotelvamanainn.com$ [NC]
   ##RewriteRule ^(.*)$ https://www.hotelvamanainn.com/$1 [R=301,L]

# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP_HOST} ^hotelvamanainn\.com$ [OR]
# RewriteCond %{HTTP_HOST} ^www\.hotelvamanainn\.com$
# RewriteRule .* https://www.hotelvamanainn.com%{REQUEST_URI} [R=301,L]

# RewriteCond %{HTTPS} =on
# RewriteCond %{HTTP_HOST} ^hotelvamanainn\.com
# RewriteRule .* https://www.hotelvamanainn.com%{REQUEST_URI} [R=301,L]

</IfModule>
